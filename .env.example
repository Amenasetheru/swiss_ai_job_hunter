# Define the PostgreSQL database created during container initialization
POSTGRES_DB=swiss_ai_job_hunter

# Define the PostgreSQL administrative user used only for initialization
POSTGRES_USER=postgres

# Define a placeholder password for the PostgreSQL administrative user
POSTGRES_PASSWORD=replace_with_a_secure_admin_password

# Define the dedicated database user used by the application
APP_DB_USER=swiss_ai_job_hunter_user

# Define a placeholder password for the application database user
APP_DB_PASSWORD=replace_with_a_secure_application_password

# Define the PostgreSQL port exposed on the local machine
POSTGRES_PORT=5432

# Define the SQLAlchemy connection URL used by the Python application
DATABASE_URL=postgresql+psycopg://swiss_ai_job_hunter_user:replace_with_a_secure_application_password@localhost:5432/swiss_ai_job_hunter

# Define the future OpenAI API key
OPENAI_API_KEY=replace_with_your_openai_api_key
