# Define the PostgreSQL database name
POSTGRES_DB=swiss_ai_job_hunter

# Define the PostgreSQL application user
POSTGRES_USER=swiss_ai_job_hunter_user

# Define a placeholder PostgreSQL password
POSTGRES_PASSWORD=replace_with_a_secure_password

# Define the SQLAlchemy PostgreSQL connection URL
DATABASE_URL=postgresql+psycopg://swiss_ai_job_hunter_user:replace_with_a_secure_password@localhost:5432/swiss_ai_job_hunter

# Define a placeholder OpenAI API key
OPENAI_API_KEY=replace_with_your_openai_api_key
